<mxCell id="n_be_disp" value="Invoke deliverOtp(email, otp)&#xa;&amp; Return HTTP 202 Accepted" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_be"><mxGeometry x="90" y="560" width="175" height="55" as="geometry"/></mxCell>
<mxCell id="n_mail_send" value="Render HTML Email Template&#xa;&amp; Transmit Message via SMTP/SES" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_mail"><mxGeometry x="60" y="560" width="170" height="55" as="geometry"/></mxCell>
<mxCell id="n_fe_scr_otp" value="Switch to OTP Verification Screen&#xa;&amp; Initiate 5-Minute Countdown Timer" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_fe"><mxGeometry x="75" y="640" width="170" height="55" as="geometry"/></mxCell>
<mxCell id="n_g_enter_otp" value="Check Email Inbox, Copy 6-Digit OTP&#xa;&amp; Enter Code into Verification Input" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_guest"><mxGeometry x="75" y="640" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="n_fe_submit_otp" value="Submit POST /v1/auth/otp/verify&#xa;(phone, otp, purpose=&apos;register&apos;)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_fe"><mxGeometry x="75" y="730" width="170" height="55" as="geometry"/></mxCell>
<mxCell id="n_be_verify" value="Validate SHA-256(otp) Hash Match&#xa;against otp_challenges Record" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_be"><mxGeometry x="90" y="730" width="175" height="60" as="geometry"/></mxCell>
<mxCell id="n_be_dec3" value="Code Valid &amp;&#xa;Unexpired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=10;fontColor=#854d0e;align=center;" vertex="1" parent="lane_be"><mxGeometry x="130" y="815" width="95" height="60" as="geometry"/></mxCell>
<mxCell id="n_be_err3" value="Return HTTP 400 Bad Request (BR-03/04)&#xa;&apos;Invalid code or challenge expired&apos;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontSize=11;fontColor=#991b1b;align=center;shadow=1;" vertex="1" parent="lane_be"><mxGeometry x="90" y="900" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="n_db_insert_user" value="INSERT INTO users (...)&#xa;(role=&apos;member&apos;, status=&apos;active&apos;,&#xa;member_code=&apos;M-XXXXXX&apos;, pii_consent_at)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_db"><mxGeometry x="65" y="815" width="185" height="65" as="geometry"/></mxCell>
<mxCell id="n_db_del_otp" value="DELETE FROM otp_challenges&#xa;WHERE id = $1 (Invalidate Challenge)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_db"><mxGeometry x="65" y="900" width="185" height="50" as="geometry"/></mxCell>
<mxCell id="n_db_audit" value="INSERT INTO audit_logs&#xa;(action=&apos;register&apos;, entity=&apos;user&apos;, target_id)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_db"><mxGeometry x="65" y="970" width="185" height="45" as="geometry"/></mxCell>
<mxCell id="n_be_issue_jwt" value="Issue Signed JWT Token &amp; User Session&#xa;&amp; Return HTTP 200 OK" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_be"><mxGeometry x="90" y="970" width="175" height="55" as="geometry"/></mxCell>
<mxCell id="n_fe_success" value="Store JWT in Session Storage,&#xa;Trigger Welcome Sonner Toast&#xa;&amp; Redirect to Member Portal (/app)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_fe"><mxGeometry x="75" y="1050" width="170" height="65" as="geometry"/></mxCell>
<mxCell id="n_end" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#ef4444;strokeWidth=2;html=1;" vertex="1" parent="lane_guest"><mxGeometry x="140" y="1065" width="32" height="32" as="geometry"/></mxCell>
