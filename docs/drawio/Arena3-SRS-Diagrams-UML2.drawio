<mxCell id="e_jwt_fe" value="HTTP 200 OK + JWT Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_issue_jwt" target="n_fe_success"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_fe_end" value="Redirect Authenticated User" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_fe_success" target="n_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
