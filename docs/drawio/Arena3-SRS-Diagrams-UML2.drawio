<mxCell id="e_disp_mail" value="Async Dispatch Task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_disp" target="n_mail_send"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_disp_fe" value="HTTP 202 Accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_disp" target="n_fe_scr_otp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_mail_g" value="Deliver Email with Code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_mail_send" target="n_g_enter_otp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
