<mxCell id="n_be_gen" value="Generate 6-Digit Random OTP&#xa;&amp; Compute SHA-256 Hash" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="lane_be"><mxGeometry x="90" y="470" width="175" height="60" as="geometry"/></mxCell>
