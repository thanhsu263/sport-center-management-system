<mxCell id="e_err1_back" value="Correct Form Inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_fe_err1" target="n_g_fill"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="332"/><mxPoint x="30" y="332"/><mxPoint x="30" y="152"/><mxPoint x="75" y="152"/></Array></mxGeometry></mxCell>
<mxCell id="e_dec1_yes" value="[Valid]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#15803d;fontSize=10;" edge="1" parent="1" source="n_fe_dec1" target="n_be_recv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_recv_db" value="Lookup Existing Users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_recv" target="n_db_chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_db_chk_ret" value="Query Result Set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_db_chk" target="n_be_dec2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_dec2_yes" value="[Duplicate]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#b91c1c;fontSize=10;" edge="1" parent="1" source="n_be_dec2" target="n_be_err2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_err2_fe" value="HTTP 400 Conflict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_err2" target="n_fe_err1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_dec2_no" value="[Unique]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#15803d;fontSize=10;" edge="1" parent="1" source="n_be_dec2" target="n_be_gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_gen_db" value="Persist Challenge Hash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_gen" target="n_db_save_otp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
