<mxCell id="e_gen_db" value="Persist Challenge Hash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_gen" target="n_db_save_otp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
