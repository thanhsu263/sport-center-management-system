<mxCell id="e_sub_ver" value="POST /v1/auth/otp/verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_fe_submit_otp" target="n_be_verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_ver_dec3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_verify" target="n_be_dec3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_dec3_no" value="[Mismatch / Expired]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#b91c1c;fontSize=10;" edge="1" parent="1" source="n_be_dec3" target="n_be_err3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_err3_fe" value="HTTP 400 Verification Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_be_err3" target="n_fe_scr_otp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_dec3_yes" value="[Verified]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#15803d;fontSize=10;" edge="1" parent="1" source="n_be_dec3" target="n_db_insert_user"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
