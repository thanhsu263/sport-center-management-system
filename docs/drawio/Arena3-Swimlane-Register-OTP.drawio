<mxCell id="e_del_aud" value="Invalidate Challenge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_db_del_otp" target="n_db_audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
