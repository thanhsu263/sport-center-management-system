<diagram id="page_swimlane" name="3. Swimlane Activity Diagram (UML 2.0)"><mxGraphModel dx="1680" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="act_title" value="MEMBER REGISTRATION &amp; EMAIL OTP VERIFICATION PROCESS — SWIMLANE ACTIVITY DIAGRAM (UML 2.0)&#xa;FPT University Capstone / SWR302 Standard · 5 Partitions: Guest | Web Client | API Server | Mail Delivery | PostgreSQL DB" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;rounded=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell>
