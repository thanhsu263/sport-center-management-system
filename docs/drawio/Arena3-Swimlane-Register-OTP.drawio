<mxCell id="e_db_chk_ret" value="Query Result Set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n_db_chk" target="n_be_dec2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
