<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Arena3 Architecture">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Arena3 - Layered Architecture (Client / Server / Data)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="800" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="laneFE" value="FRONTEND (Presentation Layer) - React + TanStack Router, runs in browser" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="480" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="fePublic" value="&lt;b&gt;Public Pages&lt;/b&gt;&lt;br&gt;index (landing), login, register, forgot, pay.return, verify" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="50" width="440" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="feMember" value="&lt;b&gt;Member Portal&lt;/b&gt; (routes/app.*)&lt;br&gt;book, classes, pass, plans, points, train, assistant" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="130" width="440" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="feCoach" value="&lt;b&gt;Coach Portal&lt;/b&gt; (routes/coach.*)&lt;br&gt;classes, attendance, earnings, student profile" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="210" width="440" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="feDesk" value="&lt;b&gt;Front Desk Portal&lt;/b&gt; (routes/desk.*)&lt;br&gt;gate check-in, courts, classes, payments, gear, maintenance, at-risk" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="290" width="440" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="feManager" value="&lt;b&gt;Manager Portal&lt;/b&gt; (routes/manager.*)&lt;br&gt;reports, prices, plans, promos, staff, commission, invoices, audit" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="370" width="440" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="feComp" value="&lt;b&gt;Shared UI Components&lt;/b&gt; (src/components)&lt;br&gt;ui/*, shell, court-grid, calendar, effects (fx, gl, motion), landing" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="470" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="feClient" value="&lt;b&gt;Client Services&lt;/b&gt; (src/lib)&lt;br&gt;use-read (REST calls), use-live (SSE), i18n (EN/VI), theme, auth/client" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#1d4ed8;" vertex="1" parent="laneFE">
          <mxGeometry x="20" y="580" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="laneBE" value="BACKEND (Application + Business Layer) - Node server, src/lib/arena3" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#15803d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="640" height="780" as="geometry"/>
