          <mxGeometry x="20" y="50" width="600" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="beRouter" value="&lt;b&gt;Router and Middleware&lt;/b&gt; (router.ts, session.ts, tx.ts, ratelimit.ts)&lt;br&gt;authentication, role check (requireRole), transaction, idempotency, rate limit" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="laneBE">
