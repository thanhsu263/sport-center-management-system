<mxfile host="app.diagrams.net"><diagram id="arena3-arch" name="Architecture"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Arena3 – System Architecture and Technology Stack" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontFamily=Helvetica;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="40" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Users (Web Browser)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="200" height="300" as="geometry"/></mxCell><mxCell id="u_roles" value="&lt;b&gt;Actors&lt;/b&gt;&lt;hr&gt;• Visitor (landing page)&lt;br&gt;• Member&lt;br&gt;• Receptionist (desk)&lt;br&gt;• Coach&lt;br&gt;• Manager&lt;br&gt;&lt;br&gt;Desktop and mobile browsers&lt;br&gt;Language: English / Vietnamese" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="170" height="245" as="geometry"/></mxCell><mxCell id="tooling" value="&lt;b&gt;Dev Tooling and Quality&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="200" height="410" as="geometry"/></mxCell><mxCell id="t_list" value="&lt;b&gt;Toolchain&lt;/b&gt;&lt;hr&gt;• TypeScript 5 (tsc --noEmit)&lt;br&gt;• Vite 8 + @vitejs/plugin-react&lt;br&gt;• ESLint 9 + Prettier 3&lt;br&gt;• node:test + tsx (unit tests)&lt;br&gt;• Playwright (UI checks, screenshots)&lt;br&gt;• scripts/arena3-api-check.mjs&lt;br&gt;• check-auth-invariant.mjs&lt;br&gt;• graft (code graph search)&lt;br&gt;• draw.io UML 2.0 docs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="45" y="460" width="170" height="355" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;Runtime and Deploy&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="200" height="210" as="geometry"/></mxCell><mxCell id="d_list" value="&lt;b&gt;Environment&lt;/b&gt;&lt;hr&gt;• Node.js server (Nitro output)&lt;br&gt;• Dev server on port 8080&lt;br&gt;• npm run build = vite build + db:migrate&lt;br&gt;• Config via env vars and secret files" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="45" y="900" width="170" height="150" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;CLIENT – React 19 SPA with SSR hydration (TanStack Router)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="1010" height="300" as="geometry"/></mxCell><mxCell id="c_routes" value="&lt;b&gt;Routes (file-based, src/routes)&lt;/b&gt;&lt;hr&gt;/ landing · /login · /register · /forgot&lt;br&gt;/app/* Member (10) · /desk/* Receptionist (11)&lt;br&gt;/coach/* Coach (6) · /manager/* Manager (16)&lt;br&gt;routeTree.gen.ts (generated)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="310" height="115" as="geometry"/></mxCell><mxCell id="c_ui" value="&lt;b&gt;UI Kit and Styling&lt;/b&gt;&lt;hr&gt;Tailwind CSS 4 + tw-animate-css&lt;br&gt;Radix UI primitives (shadcn-style ui/)&lt;br&gt;lucide-react icons · sonner toasts · vaul · cmdk&lt;br&gt;class-variance-authority · tailwind-merge" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="310" height="115" as="geometry"/></mxCell><mxCell id="c_fx" value="&lt;b&gt;Motion and Visual Effects&lt;/b&gt;&lt;hr&gt;GSAP 3 + ScrollTrigger (landing, moments)&lt;br&gt;motion (in-app transitions)&lt;br&gt;OGL WebGL (gl.tsx) · fx.tsx effects&lt;br&gt;Honours prefers-reduced-motion" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="310" height="115" as="geometry"/></mxCell><mxCell id="c_state" value="&lt;b&gt;State and Data Access&lt;/b&gt;&lt;hr&gt;TanStack Query 5 (server cache)&lt;br&gt;zustand (client state)&lt;br&gt;api&amp;lt;T&amp;gt;() in src/lib/arena3/client.ts&lt;br&gt;connection.ts health banner" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="310" height="115" as="geometry"/></mxCell><mxCell id="c_forms" value="&lt;b&gt;Forms, Tables and Charts&lt;/b&gt;&lt;hr&gt;react-hook-form + zod 4 validation&lt;br&gt;TanStack Table 8 · react-day-picker&lt;br&gt;recharts (reports) · date-fns&lt;br&gt;qrcode (check-in / transfer QR)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="610" y="250" width="310" height="115" as="geometry"/></mxCell><mxCell id="c_i18n" value="&lt;b&gt;Internationalisation&lt;/b&gt;&lt;hr&gt;src/lib/i18n (EN first, VI second)&lt;br&gt;Be Vietnam Pro font (@fontsource)&lt;br&gt;lang-switch component&lt;br&gt;Design system: DESIGN.md (Floodlit Hall)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="940" y="250" width="310" height="115" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;SERVER – TanStack Start + Nitro on Node.js (SSR pages and REST API /v1/*)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="1010" height="410" as="geometry"/></mxCell><mxCell id="s_entry" value="&lt;b&gt;API Entry&lt;/b&gt;&lt;hr&gt;src/routes/v1.$.ts&lt;br&gt;GET/POST/PUT/PATCH/DELETE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="280" y="470" width="170" height="75" as="geometry"/></mxCell><mxCell id="s_router" value="&lt;b&gt;Router&lt;/b&gt;&lt;hr&gt;arena3/router.ts&lt;br&gt;dispatch() by path + method" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="170" height="75" as="geometry"/></mxCell><mxCell id="s_session" value="&lt;b&gt;Session and Roles&lt;/b&gt;&lt;hr&gt;session.ts · crypto.ts&lt;br&gt;hashed tokens, role guard" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="180" height="75" as="geometry"/></mxCell><mxCell id="s_limit" value="&lt;b&gt;Rate Limit and Idempotency&lt;/b&gt;&lt;hr&gt;ratelimit.ts (sliding window)&lt;br&gt;withIdempotency (helpers.ts)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="180" height="75" as="geometry"/></mxCell><mxCell id="s_tx" value="&lt;b&gt;Transaction&lt;/b&gt;&lt;hr&gt;tx.ts withTx()&lt;br&gt;errors.ts ApiError → JSON" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="190" height="75" as="geometry"/></mxCell><mxCell id="s_handlers" value="&lt;b&gt;Handlers (src/lib/arena3/handlers)&lt;/b&gt;&lt;hr&gt;auth · members · plans · bookings&lt;br&gt;classes · desk · checkin · attendance&lt;br&gt;training · staff · coaches&lt;br&gt;courts · sports · promos · online&lt;br&gt;reports · ops · assets · extras&lt;br&gt;&lt;br&gt;One module per business area;&lt;br&gt;each receives (sql, request)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="280" y="580" width="330" height="230" as="geometry"/></mxCell><mxCell id="s_domain" value="&lt;b&gt;Domain Rules&lt;/b&gt;&lt;hr&gt;rules.ts · policy.ts&lt;br&gt;pricing.ts · promos.ts&lt;br&gt;rrule.ts (recurring slots)&lt;br&gt;checkin.ts (tokens)&lt;br&gt;validate.ts · phone.ts&lt;br&gt;time.ts (ICT timezone)&lt;br&gt;pdf.ts (pdf-lib, receipts)&lt;br&gt;money-words.ts · labels.ts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="630" y="580" width="210" height="230" as="geometry"/></mxCell><mxCell id="s_jobs" value="&lt;b&gt;Background Jobs&lt;/b&gt;&lt;hr&gt;jobs.ts startJobLoop()&lt;br&gt;• expire court holds&lt;br&gt;• mark no-shows&lt;br&gt;• withdraw lapsed payOS links&lt;br&gt;&lt;br&gt;Runs in-process via withTx()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="180" height="230" as="geometry"/></mxCell><mxCell id="s_integr" value="&lt;b&gt;Integration Adapters&lt;/b&gt;&lt;hr&gt;payos.ts (@payos/node)&lt;br&gt;vietqr.ts · bank.ts&lt;br&gt;notify.ts (nodemailer)&lt;br&gt;gemini.ts (AI assistant)&lt;br&gt;media.ts · media-files.ts&lt;br&gt;translator.ts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="1060" y="580" width="190" height="230" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;DATA – PostgreSQL&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="860" width="1010" height="210" as="geometry"/></mxCell><mxCell id="d_adapter" value="&lt;b&gt;DB Adapter (src/lib/db.ts)&lt;/b&gt;&lt;hr&gt;getSql(): tagged template + .query()&lt;br&gt;Parameterized SQL, normalized types&lt;br&gt;kysely (auth tables)&lt;br&gt;better-auth (sign-in gate)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="280" y="900" width="230" height="150" as="geometry"/></mxCell><mxCell id="d_neon" value="&lt;b&gt;Neon Postgres (production)&lt;/b&gt;&lt;hr&gt;Used when DATABASE_URL is set&lt;br&gt;driver: pg (node-postgres)&lt;br&gt;@neon/config · @neon/env&lt;br&gt;SQL functions, e.g. occupancy_release_booking" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="530" y="900" width="230" height="150" as="geometry"/></mxCell><mxCell id="d_pglite" value="&lt;b&gt;PGlite (local / preview)&lt;/b&gt;&lt;hr&gt;Postgres compiled to WASM&lt;br&gt;@electric-sql/pglite&lt;br&gt;Fallback when DATABASE_URL is unset&lt;br&gt;Same schema and results as Neon" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="780" y="900" width="230" height="150" as="geometry"/></mxCell><mxCell id="d_migr" value="&lt;b&gt;Schema Migrations&lt;/b&gt;&lt;hr&gt;migrations/0001 … 0035 (.sql)&lt;br&gt;scripts/migrate.mjs (db:migrate)&lt;br&gt;migration-plan.mjs&lt;br&gt;Applied to Neon and PGlite" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="1030" y="900" width="220" height="150" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;EXTERNAL SERVICES&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontFamily=Helvetica;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1310" y="80" width="260" height="990" as="geometry"/></mxCell><mxCell id="x_payos" value="&lt;b&gt;payOS&lt;/b&gt;&lt;hr&gt;Online payment links&lt;br&gt;Webhook / return (/pay/return)&lt;br&gt;Hold expiry handled by jobs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="1325" y="120" width="230" height="135" as="geometry"/></mxCell><mxCell id="x_vietqr" value="&lt;b&gt;VietQR / Bank Transfer&lt;/b&gt;&lt;hr&gt;Bank-transfer QR codes&lt;br&gt;Desk confirms payment&lt;br&gt;transfer-qr-modal" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="1325" y="275" width="230" height="135" as="geometry"/></mxCell><mxCell id="x_smtp" value="&lt;b&gt;SMTP E-mail&lt;/b&gt;&lt;hr&gt;nodemailer transport&lt;br&gt;OTP, notifications&lt;br&gt;Ethereal test inbox in dev" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;a